generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  ATTENDANT
}

enum UserStatus {
  ONLINE
  OFFLINE
}

enum EmergencyCallStatus {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
}

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  password String
  role     UserRole
  phone    String
  status   UserStatus @default(OFFLINE)

  vehicle              Vehicle?
  registeredCalls      EmergencyCall[]        @relation("AttendantCalls")
  conversationsAsAttendant Conversation[]     @relation("AttendantConversations")
  conversationsAsDriver    Conversation[]     @relation("DriverConversations")
  sentMessages             Message[]

  createdAt DateTime @default(now())
}

model Vehicle {
  id        String @id @default(uuid())
  plate     String @unique
  latitude  Float
  longitude Float

  driverId String  @unique
  driver   User    @relation(fields: [driverId], references: [id])

  emergencyCalls VehicleEmergencyCall[]
}

model EmergencyCall {
  id                  String  @id @default(uuid())
  protocol            String  @unique
  address             String
  returnLocation      String
  whatHappened        String
  patientCondition    String
  apparentAge         Int?
  patientCount        Int
  injuryCondition     String
  observations        String?

  attendantId String
  attendant   User @relation("AttendantCalls", fields: [attendantId], references: [id])

  vehicles      VehicleEmergencyCall[]
  notifications Notification[]

  createdAt DateTime @default(now())
}

model VehicleEmergencyCall {
  id     String              @id @default(uuid())
  status EmergencyCallStatus @default(NOT_STARTED)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  emergencyCallId String
  emergencyCall   EmergencyCall @relation(fields: [emergencyCallId], references: [id])
}

model Conversation {
  id String @id @default(uuid())

  attendantId String
  attendant   User @relation("AttendantConversations", fields: [attendantId], references: [id])

  driverId String
  driver   User @relation("DriverConversations", fields: [driverId], references: [id])

  messages Message[]
}

model Message {
  id      String   @id @default(uuid())
  text    String
  sentAt  DateTime @default(now())

  senderId String
  sender   User     @relation(fields: [senderId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  notifiedAt DateTime @default(now())

  emergencyCallId String
  emergencyCall   EmergencyCall @relation(fields: [emergencyCallId], references: [id])
}
